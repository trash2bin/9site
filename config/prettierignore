# зависимости
node_modules/

# lock-файл npm форматирует сам, иначе будет вечный конфликт
package-lock.json

# ассеты — бинарники и сгенерированные вручную SVG, трогать нельзя.
# Паттерн относится и к public/assets/: Prettier ищет его в любом каталоге.
assets/

# артефакты сборки и рантайма
# (Prettier не читает .gitignore, потому что ему передан явный --ignore-path,
# поэтому искусственное из .gitignore надо повторять здесь)
build/
site-server
*.log
*.pid
visits.dat
visits.dat.tmp

# данные авторизации (база, аватары, письма)
var/

# собранный минифицированный JS из src/*.ts, генерируется esbuild
js/

# отладочные скриншоты
*.png
*.jpg
*.jpeg

# служебное
.DS_Store
.pi/
.playwright-mcp/

# шаблоны Go: {{if}} внутри тега (условный open у <dialog>) Prettier не разбирает;
# каталог один (auth/templates), поэтому паттерн без пути
templates/
api-types.ts
openapi.json
