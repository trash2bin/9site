{
  "openapi": "3.1.0",
  "info": {
    "title": "Ivan's Little Web API",
    "version": "1",
    "description": "JSON API витрины и действие удаления для сессии администратора."
  },
  "paths": {
    "/api/photos": {
      "get": {
        "operationId": "photos",
        "summary": "Снимки, разделы и теги витрины",
        "description": "Открыт всем, ответ не кэшируется (Cache-Control: no-store).",
        "responses": {
          "200": {
            "description": "Весь альбом",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhotosResponse"
                }
              }
            }
          },
          "500": {
            "description": "База не читается",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/vault/album/delete": {
      "post": {
        "operationId": "deletePhoto",
        "summary": "Удалить кадр",
        "description": "Доступно администратору; нужен CSRF-токен из photos.viewer.csrf. Чужой кадр обычному пользователю запрещён.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "csrf": {
                    "type": "string"
                  },
                  "id": {
                    "type": "integer"
                  }
                },
                "required": [
                  "csrf",
                  "id"
                ]
              }
            }
          }
        },
        "responses": {
          "303": {
            "description": "Кадр удалён, переход на страницу альбома"
          },
          "403": {
            "description": "Недостаточно прав или неверный CSRF-токен"
          },
          "404": {
            "description": "Кадр не найден"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Photo": {
        "properties": {
          "id": {
            "type": "integer",
            "description": "идентификатор записи для действий владельца"
          },
          "name": {
            "type": "string",
            "description": "подпись кадра"
          },
          "url": {
            "type": "string",
            "description": "путь файла от корня сайта"
          },
          "album": {
            "type": "string",
            "description": "слаг раздела"
          },
          "width": {
            "type": "integer",
            "description": "ширина файла в px"
          },
          "height": {
            "type": "integer",
            "description": "высота файла в px"
          },
          "author": {
            "type": "string",
            "description": "логин загрузившего или system для засева"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "description": "теги кадра по алфавиту"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "url",
          "album",
          "width",
          "height",
          "author",
          "tags"
        ]
      },
      "PhotosResponse": {
        "properties": {
          "photos": {
            "items": {
              "$ref": "#/components/schemas/Photo"
            },
            "type": "array"
          },
          "albums": {
            "items": {
              "$ref": "#/components/schemas/Section"
            },
            "type": "array"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "viewer": {
            "$ref": "#/components/schemas/Viewer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "photos",
          "albums",
          "tags",
          "viewer"
        ]
      },
      "Section": {
        "properties": {
          "slug": {
            "type": "string",
            "description": "слаг раздела из album.Sections"
          },
          "label": {
            "type": "string",
            "description": "подпись для интерфейса"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "slug",
          "label"
        ]
      },
      "Viewer": {
        "properties": {
          "admin": {
            "type": "boolean"
          },
          "csrf": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "admin",
          "csrf"
        ]
      }
    }
  }
}
