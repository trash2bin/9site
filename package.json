{
  "name": "web1-personal-site",
  "version": "1.0.0",
  "private": true,
  "description": "Ivan's Little Web — статичный сайт в эстетике Web 1.0",
  "scripts": {
    "format": "prettier --config config/prettierrc.json --ignore-path config/prettierignore --write .",
    "format:check": "prettier --config config/prettierrc.json --ignore-path config/prettierignore --check .",
    "lint:css": "stylelint --config config/stylelintrc.json \"public/**/*.css\"",
    "lint:css:fix": "stylelint --config config/stylelintrc.json \"public/**/*.css\" --fix",
    "lint:go": "gofmt -l . && go vet ./...",
    "size": "bash scripts/check-size.sh",
    "lint": "npm run format:check && npm run lint:css && npm run lint:go && npm run size",
    "fix": "npm run format && npm run lint:css:fix"
  },
  "devDependencies": {
    "prettier": "^3.9.7",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^38.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
