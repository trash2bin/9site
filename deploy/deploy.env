# The environment of the service, one source. The unit reads it through
# EnvironmentFile, and the deploy scripts read the same file, so the unit
# and the scripts cannot disagree about where the data lives.
DATA_DIR=/var/www/9site/var
VISITS_FILE=/var/www/9site/var/visits.dat
STATIC_ROOT=/var/www/9site/public
BASE_URL=https://9swag.myftp.biz
# Password letters go through SMTP; leave the provider empty and no mail is sent.
#SMTP_PROVIDER=gmail
#SMTP_USER=you@gmail.com
#SMTP_PASS=app-password
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
# The secret admin from the environment: the server creates the account or
# refreshes its password on every start, so this is the way back in when the
# password is lost. Set both or neither.
#ADMIN_LOGIN=owner
#ADMIN_PASSWORD=replace-with-a-long-password
