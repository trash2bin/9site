[Unit]
Description=9site static web server
Documentation=https://github.com/trash2bin/9site
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/www/9site
ExecStart=/var/www/9site/site-server

# Пользовательский юнит, без root и sudo: работает от имени deploy.
#
# Никаких sandbox-строк (ProtectSystem, ReadWritePaths, capability и пр.).
# Пользовательский менеджер на хосте деплоя падает на шаге CAPABILITIES с
# EPERM (exit 218) для любого user-юнита, и сервис не стартует вовсе. Сам
# бинарь это непривилегированный Go-процесс на 127.0.0.1 со своими HTTP-защитами
# (AGENTS.md), так что sandbox systemd был вторым эшелоном, а не самой защитой.

# Данные лежат в var/ рабочего каталога (это дефолт DATA_DIR бинарника).
# Один источник окружения: файл кладёт деплой, его же читают скрипты.
EnvironmentFile=/var/www/9site/deploy.env

Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
