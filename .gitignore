# зависимости (нужны только для линтеров, сайт их не использует)
node_modules/

# артефакты сборки и рантайма
/site-server
/build/
*.log
*.pid

# локальный счётчик визитов (в проде лежит в /var/lib/9site)
/visits.dat
/visits.dat.tmp

# данные авторизации: база SQLite, аватары, исходящие письма
# (в проде лежат в /var/lib/9site)
/var/

# SQLite: WAL-спутники базы и бэкапы импортированных старых баз
# (сама база живёт в /var, паттерны — на случай данных рядом с бинарником)
*.db-wal
*.db-shm
*.db-journal
*.db.bak
visits.dat.bak

# отладочные скриншоты (корень и вложенные папки, но не public/assets)
/*.png
/*.jpg
/*.jpeg

# система
.DS_Store

# локальная настройка Pi-агента, к проекту не относится
.pi/
.playwright-mcp/
